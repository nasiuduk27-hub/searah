# Database (Docker lokal ATAU Supabase free tier kalau Docker belum ada)
DATABASE_URL=postgresql://searah:searah_dev@localhost:5432/searah
POSTGRES_USER=searah
POSTGRES_PASSWORD=searah_dev
POSTGRES_DB=searah
POSTGRES_PORT=5432

# Redis (rate-limit OTP/chat, pre-filter geohash)
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# Auth / OTP
JWT_SECRET=isi_dengan_random_string_panjang
ADMIN_TOKEN=isi_token_admin_review_manual
OTP_PROVIDER=dummy
OTP_RATE_LIMIT_PER_HOUR=5
NEXT_PUBLIC_API_URL=http://localhost:3001

# Storage S3-compatible (foto KTP/selfie — wajib terenkripsi, tidak publik)
S3_ENDPOINT=
S3_BUCKET=searah-identity-docs
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=ap-southeast-1
IDENTITY_DOCS_ENCRYPTION_KEY=isi_32_byte_base64

# Maps / routing (dipakai hanya tahap 4 matching, setelah pre-filter lolos)
GOOGLE_MAPS_API_KEY=
OSRM_BASE_URL=

# Realtime chat (pilih satu: socketio self-host ATAU firebase)
CHAT_PROVIDER=socketio
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Web Push (notifikasi web, terbatas di iOS Safari)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Feature flags per fase PRD
FF_CARPOOL_POSTING=false
FF_CHAT_1ON1=false
FF_PERSONAL_MATCH=false
